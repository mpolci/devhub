	(text "Bobina G5Q-1 senza polarità: pin 5 a +5V, pin 1 a tre uscite in parallelo del ULN2003V12 (diodi di ricircolo nel driver, COM a +5V)."
		(exclude_from_sim no)
		(at 14.478 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "09842cf1-1c7e-556f-a143-78f0fa4a46a1")
	)
	(text "JP2/JP3 (default 1-2 = NC) portano NO sulla seconda boccola se serve un canale normalmente aperto. Snubber R/C opzionali (DNP)."
		(exclude_from_sim no)
		(at 14.478 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3942f3ae-c0fd-5b43-bc91-3e03a07c1908")
	)
	(text "Boccole Cliff FCR7350 (4 mm da pannello, montaggio su PCB): nera = COM, rossa = NC (o NO con JP)."
		(exclude_from_sim no)
		(at 14.478 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "60778e05-c97a-5d63-9a82-b559ff47cbf9")
	)
	(text "Contatti max 16 V / 3 A. Sul pannello COM e NC: linea normalmente collegata, bobina eccitata solo per staccare."
		(exclude_from_sim no)
		(at 14.478 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "644ecca7-f81d-57f1-b4bf-305c6644b5b4")
	)
	(text "SW1/SW2: ogni pressione alterna la linea del relè (collegata / staccata), come i pulsanti delle porte."
		(exclude_from_sim no)
		(at 101.6 137.16 0)
		(effects

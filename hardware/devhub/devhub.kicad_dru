(version 1)

# =============================================================================
# Regole DRC personalizzate - devhub
# Riferimento: docs/regole-pcb.md
# Netclass, larghezze iniziali e minimi globali sono in devhub.kicad_pro.
# =============================================================================

# -----------------------------------------------------------------------------
# Dimensioni iniziali: solo via passanti, niente microvia, via ciechi o interrati.
# -----------------------------------------------------------------------------

(rule "Solo via passanti"
   (constraint disallow micro_via buried_via)
)

# -----------------------------------------------------------------------------
# Coppie USB: 90 ohm differenziali, B.Cu su In2.Cu (o F.Cu su In1.Cu),
# JLC04161H-7628. Pista 0,2474, gap 0,1519; 0,15 solo nel fanout dai pad.
# Coppie riconosciute da KiCad con i nomi ...DP / ...DN. La differenza di
# lunghezza è per singola rete e dentro ciascuna coppia: il totale attraverso
# ESD o switch va sommato a mano; le porte non si pareggiano fra loro.
# -----------------------------------------------------------------------------

(rule "USB vincoli fisici"
   (constraint clearance (min 0.15mm))
   (constraint track_width (min 0.15mm) (opt 0.2474mm))
   (constraint diff_pair_gap (min 0.15mm) (opt 0.1519mm))
   (constraint skew (max 0.5mm) (within_diff_pairs))
   (condition "A.hasNetclass('USB_DIFF')")
)

# Distanza da altre piste, anche di altre coppie USB, e da rame laterale (zone)
# fuori dai fanout: >= 0,75. Esclude la propria coppia, pad e via, quindi gap,
# fanout e via GND di ritorno restano liberi.

(rule "USB distanza da altre reti"
   (constraint clearance (min 0.75mm))
   (condition "A.hasNetclass('USB_DIFF') && A.Type == 'Track' && (B.Type == 'Track' || B.Type == 'Zone') && !A.isCoupledDiffPair()")
)

# Fanout del USB2517: pad a passo 0,5 e coppie adiacenti a 1 mm di passo, la
# distanza di 0,75 non è ottenibile all'uscita dai pad. Vale solo fra tratti USB
# interamente dentro le aree di regola USB_FANOUT_U2, a ridosso dei pin.

(rule "USB fanout USB2517"
   (constraint clearance (min 0.15mm))
   (condition "A.hasNetclass('USB_DIFF') && B.hasNetclass('USB_DIFF') && A.insideArea('USB_FANOUT_U2') && B.insideArea('USB_FANOUT_U2')")
)

# -----------------------------------------------------------------------------
# Alimentazione: larghezze iniziali di netclass. Un tratto più stretto è un
# restringimento da controllare localmente (pad, fanout): segnalato come avviso.
# -----------------------------------------------------------------------------

(rule "PWR_MAIN larghezza iniziale"
   (severity warning)
   (constraint track_width (min 2.0mm))
   (condition "A.hasNetclass('PWR_MAIN')")
)

(rule "PWR_PORT larghezza iniziale"
   (severity warning)
   (constraint track_width (min 1.5mm))
   (condition "A.hasNetclass('PWR_PORT')")
)

(rule "PWR_3V3 larghezza iniziale"
   (severity warning)
   (constraint track_width (min 0.6mm))
   (condition "A.hasNetclass('PWR_3V3')")
)

(rule "SENSE larghezza iniziale"
   (severity warning)
   (constraint track_width (min 0.2mm))
   (condition "A.hasNetclass('SENSE')")
)

# -----------------------------------------------------------------------------
# Contatti dei relè: almeno 1 mm dai circuiti dell'hub e fra i due canali.
# Fra le reti dello stesso canale (COM, NC, NO, snubber) valgono il land
# pattern del relè e la clearance ordinaria: non ridurre le distanze del footprint.
# La separazione su tutti i layer (niente piani sotto i contatti) va fatta con
# aree di esclusione nel PCB, non è esprimibile come clearance.
# -----------------------------------------------------------------------------

(rule "Relè contatti verso hub"
   (constraint clearance (min 1.0mm))
   (condition "A.hasNetclass('RELAY_CONTACT') && !B.hasNetclass('RELAY_CONTACT')")
)

# Fra i due canali vale la clearance di netclass RELAY_CONTACT (1 mm).

(rule "Relè stesso canale"
   (constraint clearance (min 0.2mm))
   (condition "A.hasNetclass('RELAY_CONTACT') && B.hasNetclass('RELAY_CONTACT') && (((A.NetName == '*BAN1_*' || A.NetName == '*K1_*' || A.NetName == '*SNUB1') && (B.NetName == '*BAN1_*' || B.NetName == '*K1_*' || B.NetName == '*SNUB1')) || ((A.NetName == '*BAN2_*' || A.NetName == '*K2_*' || A.NetName == '*SNUB2') && (B.NetName == '*BAN2_*' || B.NetName == '*K2_*' || B.NetName == '*SNUB2')))")
)

# -----------------------------------------------------------------------------
# Eccezioni circoscritte ai land pattern del produttore: valgono solo fra
# oggetti della stessa impronta, senza abbassare i minimi globali.
# -----------------------------------------------------------------------------

# TPS259470A, VQFN-HR-10 passo 0,45: 0,15 fra pad adiacenti.
(rule "U13 pad interni"
   (constraint clearance (min 0.15mm))
   (condition "A.memberOfFootprint('lcsc_footprints:C3662799*') && B.memberOfFootprint('lcsc_footprints:C3662799*')")
)

# GCT USB4105: pad GND A1/A12/B1/B12 a 0,194 dai fori NPTH di centraggio.
(rule "USB-C pad e fori di centraggio"
   (constraint hole_clearance (min 0.19mm))
   (condition "A.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4105*') && B.memberOfFootprint('Connector_USB:USB_C_Receptacle_GCT_USB4105*')")
)
